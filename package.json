{
  "devDependencies": {
    "@faker-js/faker": "^9.7.0",
    "@wdio/allure-reporter": "^9.12.6",
    "@wdio/cli": "^9.12.7",
    "@wdio/local-runner": "^9.12.7",
    "@wdio/mocha-framework": "^8.1.0",
    "@wdio/spec-reporter": "^8.1.0",
    "allure-commandline": "^2.34.0"
  },
  "scripts": {
    "wdio:pixel": "npx wdio ./configs/googlePixel.conf.js",
    "wdio:samsung": "npx wdio ./configs/samsung.conf.js",
    "allure:install": "npm install -g allure-commandline --save-dev",
    "allure:generate": "npx allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "npx allure open ./allure-report"
  }
}
